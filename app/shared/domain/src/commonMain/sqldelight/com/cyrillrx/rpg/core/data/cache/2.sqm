ALTER TABLE Character ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;

-- SQLite 3.18 has no ALTER TABLE RENAME COLUMN, so lastModified is carried over through a transit table.
CREATE TABLE UserListMigration (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    itemIds TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0
);

INSERT INTO UserListMigration(id, name, type, itemIds, updatedAt)
SELECT id, name, type, itemIds, lastModified FROM UserList;

DROP TABLE UserList;

ALTER TABLE UserListMigration RENAME TO UserList;
